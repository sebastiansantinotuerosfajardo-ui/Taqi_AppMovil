# Copia este archivo como ".env" y completa los valores (el archivo .env NO se sube a GitHub).

# Servidor siempre encendido (Render, Railway, tu PC): pooler de SESIÓN, puerto 5432
# Reemplaza [PROYECTO], [CONTRASEÑA] y [REGION] con los datos de tu proyecto de Supabase.
DATABASE_URL="postgresql://prisma.[PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Solo si despliegas en un servicio "serverless" (por ejemplo Vercel):
#   DATABASE_URL -> pooler de TRANSACCIONES, puerto 6543, terminado en ?pgbouncer=true
#   DIRECT_URL   -> el mismo de arriba (puerto 5432), se usa para las migraciones
# DIRECT_URL="postgresql://prisma.[PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Clave que firma las sesiones. Debe tener al menos 32 caracteres: con una más corta (o con la del ejemplo)
# el servidor NO arranca. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si la cambias, todas las sesiones abiertas se cierran y cada persona debe iniciar sesión de nuevo.
JWT_SECRET="PEGA-AQUI-LA-CLAVE-GENERADA"

PORT=3000

# ---------------------------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------------------------

# Recuperar contraseña:
#   consola (si no pones nada): el código de 6 dígitos solo se escribe en la consola del servidor.
#   demo: además se devuelve en la respuesta de la API para mostrarlo en pantalla durante la presentación.
#         Úsalo SOLO en la demostración (no hay servicio de correo).
# RESET_MODO="demo"

# Navegadores que pueden llamar a la API, separados por coma. La app del celular NO necesita esto.
# En desarrollo, si no lo defines, se permite todo. En producción, "*" se ignora y se exige una lista.
# CORS_ORIGIN="https://tu-sitio.com"

# Cuántos proxys hay delante de la API: en Render, Railway o Fly pon 1; en tu PC, 0 (o no lo pongas).
# Si estás detrás de un proxy y lo dejas en 0, todos los usuarios parecerán tener la misma IP y el
# límite de intentos bloqueará a todos a la vez.
# TRUST_PROXY=1

# En el servidor publicado:
# NODE_ENV="production"

# Copia este archivo como ".env" y completa los valores (el archivo .env NO se sube a GitHub).

# Servidor siempre encendido (Render, Railway, tu PC): pooler de SESIÓN, puerto 5432
# Reemplaza [PROYECTO], [CONTRASEÑA] y [REGION] con los datos de tu proyecto de Supabase.
DATABASE_URL="postgresql://prisma.[PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Solo si despliegas en un servicio "serverless" (por ejemplo Vercel):
#   DATABASE_URL -> pooler de TRANSACCIONES, puerto 6543, terminado en ?pgbouncer=true
#   DIRECT_URL   -> el mismo de arriba (puerto 5432), se usa para las migraciones
# DIRECT_URL="postgresql://prisma.[PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Clave para firmar las sesiones. Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

PORT=3000
